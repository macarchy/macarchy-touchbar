#!/usr/bin/env python3
"""macarchy-dfr - the Touch Bar daemon and its CLI. See docs/superpowers/specs."""
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, ROOT)

if len(sys.argv) > 1 and sys.argv[1] == "daemon":
    from macarchy_dfr.daemon import main  # noqa: E402
    sys.exit(main(sys.argv[1:]) or 0)

from macarchy_dfr.ipc import client  # noqa: E402 — the CLI never loads the engine

sys.exit(client(sys.argv[1:]))
