[Unit]
Description=macarchy-touchbar - the Touch Bar, drawn by us
After=graphical-session.target
PartOf=graphical-session.target
# Retry a genuine hiccup, but stop pounding on something that is not going to
# work: on 2026-09-04 a moved DRM card node had it restart 69 times in four
# minutes, in silence. Ten tries over two minutes, then fail for real -- and
# say so.
StartLimitIntervalSec=120
StartLimitBurst=10
# The notifier is shared now: one macarchy-failed@.service instance per unit,
# shipped by macarchy-install, so every macarchy daemon says the same thing the
# same way and systemd's own StartLimit is the rate limiter.
OnFailure=macarchy-failed@%n.service

[Service]
Type=simple
ExecStart=%h/.local/bin/macarchy-touchbar daemon
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
